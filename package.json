{
  "name": "@zhucherofficial/dsh-file-drop",
  "version": "0.2.0",
  "description": "Attach dropped files and folders to DSH web conversations, start workspace-free chats, and preflight plugin conflicts.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-file-drop-resolve": "bin/resolve-conflicts.js"
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "license": "MIT",
  "author": "Ken Zhang",
  "homepage": "https://github.com/zhucherofficial/dsh-file-drop#readme",
  "bugs": {
    "url": "https://github.com/zhucherofficial/dsh-file-drop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhucherofficial/dsh-file-drop.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "file-drop",
    "attachments",
    "plugin-conflicts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2 <0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  }
}
